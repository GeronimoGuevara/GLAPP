# Configura esta variable con tu connection string de Neon
# La puedes obtener desde tu dashboard de Neon después de crear tu base de datos

VITE_DATABASE_URL=postgresql://[usuario]:[contraseña]@[endpoint].pooler.supabase.com:6543/[nombre-db]?sslmode=require

# Ejemplo:
# VITE_DATABASE_URL=postgresql://postgres.tu_id_de_proyecto:tu_contraseña@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Configuración de Cloudinary para imágenes
VITE_CLOUDINARY_CLOUD_NAME=tu_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=tu_upload_preset_unsigned
