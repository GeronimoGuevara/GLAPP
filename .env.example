# Configura esta variable con tu connection string de Neon
# La puedes obtener desde tu dashboard de Neon después de crear tu base de datos

VITE_DATABASE_URL=postgresql://[usuario]:[contraseña]@[endpoint].neon.tech/[nombre-db]?sslmode=require

# Ejemplo:
# VITE_DATABASE_URL=postgresql://neondb_owner:abc123xyz@ep-cool-name-12345.us-east-1.aws.neon.tech/neondb?sslmode=require
